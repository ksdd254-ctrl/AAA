# Copy to .env on the hosting server and fill in.
NODE_ENV=production
PORT=8080
BASE_URL=https://your-domain.com

OWNER_EMAIL=jdotweak@gmail.com

# Email (Gmail: create an "App password" in your Google account security settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JDO Tweak <your-email@gmail.com>

# Payments - https://dashboard.stripe.com/apikeys  and a webhook to https://your-domain.com/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bot protection - https://dash.cloudflare.com -> Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Link customers of the "Ultimate + Lite Windows" plan receive
LITE_WINDOWS_URL=
